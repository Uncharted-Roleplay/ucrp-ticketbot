[Unit]
Description=UCRP Ticket Bot (fork of MSK Ticket Bot)
Documentation=https://github.com/Uncharted-Roleplay/ucrp-ticketbot
# PostgreSQL on the same host: start after it, and keep retrying (no start
# limit) instead of giving up while it is still coming up after a reboot.
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ticketbot
Group=ticketbot
WorkingDirectory=/opt/ucrp-ticketbot/current
EnvironmentFile=/opt/ucrp-ticketbot/shared/.env
Environment=NODE_ENV=production
ExecStart=/opt/ucrp-ticketbot/runtime/node/bin/node index.js
Restart=always
RestartSec=10
# index.js handles SIGTERM: lets an in-flight ticket close finish (<= 7 s),
# then disconnects and closes the DB pool.
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ucrp-ticketbot

# ── Sandbox ──────────────────────────────────────────────────────────────────
# The bot only writes /opt/ucrp-ticketbot/data (update-notice marker). Code and
# config are read-only; it only talks to Discord, GitHub and local Postgres.
ProtectSystem=strict
ReadWritePaths=/opt/ucrp-ticketbot/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
MemoryMax=512M
# Deliberately absent: MemoryDenyWriteExecute (V8's JIT needs W+X pages) and
# upstream's OOMScoreAdjust=-500 (would make the kernel pick Postgres first).

[Install]
WantedBy=multi-user.target
